#!/bin/sh /etc/rc.common

# Avvio del servizio WOL HTTP Service
START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    
    # Avvia lo script con python3 unbuffered
    procd_set_param command /usr/bin/python3 -u /www/domotica/cgi-bin/wol_service.py
    
    # Redirige output ed errori ai log di sistema
    procd_set_param stdout 1
    procd_set_param stderr 1
    
    # Respawn automatico in caso di crash
    procd_set_param respawn 3600 5 0
    
    procd_close_instance
}

stop_service() {
    return 0
}
