#!/bin/sh /etc/rc.common

# Avvio del servizio per i Bot Telegram del Garage (AllarmeGarage e Serranda)
START=99
STOP=10

USE_PROCD=1
PROG="/usr/bin/python3"
ARGS="/www/domotica/garage_bot/garage_bot.py"

start_service() {
    procd_open_instance
    procd_set_param command $PROG -u $ARGS
    procd_set_param env PYTHONPATH="/www/domotica/garage_bot"
    
    # Riavvia automaticamente in caso di crash (3 tentativi, 5 sec di attesa)
    procd_set_param respawn 3600 5 0
    
    # Redirige stdout e stderr al log di sistema (visibile con logread -f)
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    return 0
}
