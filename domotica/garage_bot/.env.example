# =================================================================
# CONFIGURAZIONE BOT TELEGRAM GARAGE & BROKER MQTT (TEMPLATE)
# Cartella: /www/domotica/garage_bot/
# =================================================================

# 1. TOKEN DEL BOT "AllarmeGarage" (creato via @BotFather)
ALLARME_GARAGE_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# 2. TOKEN DEL BOT "Serranda" (creato via @BotFather)
SERRANDA_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# 3. TOKEN DEL BOT "ACSAHomeUtils" (per notifiche e approvazioni 2FA)
ACSA_UTILS_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# 4. CHAT ID AMMINISTRATORE (recuperabile tramite @userinfobot)
ADMIN_CHAT_ID=123456789

# 5. PASSWORD DI REGISTRAZIONE E HASH (per autenticazione utenti su entrambi i bot)
BOT_PASSWORD=TuaPasswordSicura!2026
BOT_PASSWORD_SALT=
BOT_PASSWORD_HASH=

# 6. BROKER MQTT LOCALE (Mosquitto)
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# 7. PARAMETRI SERRANDA
# Ritardo di stabilizzazione (in secondi) per filtrare oscillazioni voltmetro
SHUTTER_DEBOUNCE_DELAY=4.0
# Soglia di tensione (in Volt): > 5.3V = APERTA, <= 5.3V = CHIUSA
VOLTMETER_THRESHOLD=5.3
