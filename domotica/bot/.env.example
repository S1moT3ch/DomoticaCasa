# =================================================================
# CONFIGURAZIONE BOT TELEGRAM & BROKER MQTT (TEMPLATE D'ESEMPIO)
# =================================================================

# 1. INSERISCI QUI IL TOKEN DEL TUO BOT TELEGRAM (Generato tramite @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# 2. INSERISCI QUI IL TUO TELEGRAM CHAT ID (Recuperabile avviando @userinfobot su Telegram)
TELEGRAM_CHAT_ID=123456789

# 3. CONFIGURAZIONE DEL BROKER MQTT (Localhost se in esecuzione sulla stessa macchina)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Topic MQTT da ascoltare (# per ascoltare tutti i dispositivi)
MQTT_TOPIC=#

# 4. PASSWORD RICHIESTA PER LA REGISTRAZIONE DEI NUOVI UTENTI
BOT_PASSWORD=TuaPasswordSicura!2026
BOT_PASSWORD_SALT=
BOT_PASSWORD_HASH=

# 5. SECONDO BOT TELEGRAM (BOT ADMIN PER APPROVAZIONE 2FA)
ADMIN_BOT_TOKEN=
ADMIN_CHAT_ID=

# =================================================================
# 6. PARAMETRI AUTOMAZIONI & MODALITÀ VACANZA
# =================================================================
SHUTTER_DEBOUNCE_DELAY=4.0
GATE_OPEN_NOTIFY_DELAY=44.0
HUMIDITY_ALERT_THRESHOLD=60.0
ACTION_PIN=
VACATION_REPORT_TIME=09:00
VACATION_REPORT_CHAT_ID=
VACATION_ALARM_CALL_ENABLED=False
VACATION_ALARM_CALL_TARGET=
CALLMEBOT_API_KEY=
WHATSAPP_API_KEY=
WHATSAPP_PHONE=

# =================================================================
# 7. OUTAGE PREVENTION & NOTIFICHE VOCALI ALEXA
# =================================================================
OUTAGE_PREVENTION_ENABLED=True
POWER_ALERT_THRESHOLD_KW=3.9
POWER_ALERT_HYSTERESIS_KW=0.4
POWER_ALERT_COOLDOWN_SECONDS=180
ALEXA_TARGET_DEVICE=EchoPop_Cucina
ALEXA_ALERT_PROVIDER=voicemonkey
VOICEMONKEY_TOKEN=
SINRIC_POWER_DEVICE_ID=

# =================================================================
# 8. MONITOR HEARTBEAT & BLACKOUT VERCEL
# =================================================================
REMOTE_SERVER_URL=https://powermonitor-one.vercel.app/api/heartbeat
HEARTBEAT_SECRET=SecretHeartbeatKey2026
PING_INTERVAL_SECONDS=25

# =================================================================
# 9. MONITOR VOIP TELEFONO FISSO (MODEM ZTE WIND3 HUB)
# =================================================================
ZTE_ROUTER_IP=192.168.0.1
ZTE_ROUTER_USER=admin
ZTE_ROUTER_PASSWORD=
VOIP_MISSED_CALL_NOTIFY=True
VOIP_POLL_INTERVAL_SECONDS=30
VOIP_INCOMING_CALL_NOTIFY=True
VOIP_SYSLOG_PORT=514
ZTE_SYSLOG_TARGET_IP=192.168.0.2

# =================================================================
# 10. CREDENZIALI WEB DASHBOARD & PROXY ALLARME
# =================================================================
DOMOTICA_WEB_PASS=
SHELLY_ALARM_IP=192.168.4.112
SHELLY_ALARM_USER=admin
SHELLY_ALARM_PASS=
PROXY_ALARM_USER=iphone
PROXY_ALARM_PASS=

# =================================================================
# 11. OAUTH DAIKIN & NETATMO/BTICINO
# =================================================================
DAIKIN_CLIENT_ID=
DAIKIN_CLIENT_SECRET=
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REFRESH_TOKEN=
NETATMO_HOME_ID=
NETATMO_ROOM_ID=
