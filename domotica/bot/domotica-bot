#!/bin/sh /etc/rc.common

START=98
STOP=10

USE_PROCD=1
PROG="/usr/bin/python3"
ARGS="/www/domotica/bot/main.py"

start_service() {
    procd_open_instance
    # Cambiamo cartella in modo che il bot trovi i suoi file (es. config.py, database)
    procd_set_param command $PROG $ARGS
    procd_set_param env PYTHONPATH="/www/domotica/bot"
    
    # Riavvia automaticamente in caso di crash (3 tentativi, 5 sec di attesa)
    procd_set_param respawn 3600 5 0
    
    # Reindirizza l'output per poterlo leggere con "logread -f"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
